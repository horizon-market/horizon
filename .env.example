# Copy to .env. Use Node 24. No live secrets are committed.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://horizon:horizon_local_only@127.0.0.1:54329/horizon
TEST_DATABASE_URL=postgresql://horizon:horizon_local_only@127.0.0.1:54329/horizon_test
ADMIN_EMAIL=admin@horizon.local
# Generate using npm run admin:password (reads a password from stdin).
ADMIN_PASSWORD_HASH=
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Set to the number of trusted reverse proxies only when deploying behind one.
TRUST_PROXY_HOPS=0

# Phase 0 external checks. Empty values are reported as pending, never as success.
EVM_RPC_URL=
EVM_CHAIN_ID=11155111
AQUA_ADDRESS=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
EVM_DEPLOYER_ADDRESS=
# Local secret for explicitly invoked Sepolia deployment/demo scripts only.
EVM_DEPLOYER_PRIVATE_KEY=
# Populated by deploy:phase2. Required with GRAPH_QUERY_URL to enable /api markets and quotes.
HORIZON_REGISTRY_ADDRESS=
HORIZON_ROUTER_ADDRESS=
HORIZON_EXECUTOR_ADDRESS=
# Subgraph Studio deployment settings; deploy key is a local secret.
GRAPH_SUBGRAPH_SLUG=
GRAPH_DEPLOY_KEY=
GRAPH_QUERY_URL=
GRAPH_API_KEY=
# Market mirror. The worker sweeps The Graph on this interval into MarketProjection/CurveProjection
# so discovery reads Postgres instead of the indexer. Once the mirror is older than the staleness
# budget, reads fall back to The Graph on their own; set MARKET_SYNC_ENABLED=false to always do so.
MARKET_SYNC_ENABLED=true
MARKET_SYNC_INTERVAL_MS=15000
MARKET_SYNC_MAX_STALENESS_MS=120000
MARKET_SYNC_PAGE_SIZE=200

HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=hedera:testnet
HEDERA_RECEIVER_ACCOUNT_ID=
HEDERA_AGENT_ACCOUNT_ID=
# Future live-payment scripts must read secrets locally, never commit them.
HEDERA_AGENT_PRIVATE_KEY=
HEDERA_WALLETCONNECT_PROJECT_ID=
# Public audit trail on the Hedera Consensus Service. Statements about a creation request —
# the approved draft, the settled x402 payment, the deployed market — are written to a durable
# outbox with the workflow transition itself and published to this topic in the background.
# HCS records Horizon's own statements and their ordering; it does not verify the referenced
# Hedera payment, the Sepolia deployment or a market outcome.
# Set to false to record statements without publishing them.
HEDERA_AUDIT_ENABLED=true
# Defaults to the network named by HEDERA_NETWORK: testnet | previewnet | mainnet | local-node.
HEDERA_AUDIT_NETWORK=testnet
# Create with: npm run audit:topic (spends a small amount of testnet HBAR).
HEDERA_AUDIT_TOPIC_ID=
# A dedicated server-side audit signer, separate from the x402 payer and the Sepolia deployer.
# Its public key is the topic's submit key, so only this service can append to the trail. The
# reference deployment reuses HEDERA_RECEIVER_ACCOUNT_ID here; a production one would use a third,
# separate account so receiving a fee and attesting to it are not the same key.
HEDERA_AUDIT_ACCOUNT_ID=
# Local secret. Never committed, never logged and never returned by an API. Only the process that
# publishes needs it: in a split API/worker deployment, set it on the worker alone. The API needs
# the topic id above to render and verify the trail, and no key.
HEDERA_AUDIT_PRIVATE_KEY=
# How a bare 32-byte hex key is interpreted: ecdsa | ed25519 | der. A DER encoding is detected.
HEDERA_AUDIT_KEY_TYPE=ecdsa
# Public mirror node used to reconcile unknown submissions and to verify published contents.
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Explorer base for the topic and transaction links shown in the app.
HEDERA_EXPLORER_BASE=https://hashscan.io/testnet
# How often the worker sweeps the outbox for statements that are due.
HEDERA_AUDIT_PUBLISH_INTERVAL_MS=20000

WORLD_APP_ID=
WORLD_RP_ID=
# Secret RP request-signing key from the World Developer Portal. Server-side only.
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=
# staging matches the World Sandbox; production matches a live app.
WORLD_ENVIRONMENT=sandbox
# unknown | requested | granted; administrative note, not credential verification.
WORLD_SELFIE_ACCESS=unknown

# Phase 3 creation service. The x402 charge is unrelated to trading, which has no fee.
# Base creation price in the asset's smallest unit (1 HBAR = 100000000 tinybar).
CREATION_PRICE_UNITS=100000000
# Discount applied only after a successful server-side World verification, in basis points.
CREATION_DISCOUNT_BPS=5000
# Native HBAR uses the x402/Hedera asset id 0.0.0; an HTS token uses its token id.
HEDERA_ASSET_ID=0.0.0
HEDERA_ASSET_DECIMALS=8
# live settles through the configured Blocky402 facilitator; simulated performs no Hedera
# transaction and labels every record it writes as simulated. Never use simulated in production.
HEDERA_PAYMENT_MODE=live
WORLD_VERIFY_URL=https://developer.world.org
# Market drafting provider. anthropic requires ANTHROPIC_API_KEY; development is deterministic
# and still grounded on live indexed markets for duplicate detection.
AI_PROVIDER=development
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Origin allowed to call /api with credentials from another origin (the Vite dev server).
WEB_ORIGIN=http://127.0.0.1:5173

# Definition imports. Horizon reads a pasted Polymarket page address through its backend, from
# this origin only, and never fetches an arbitrary user-supplied URL. Imports copy definitions
# only: question, outcome labels, resolution criteria, evidence source and dates. Source prices,
# liquidity, volume and settlement are never imported and never become Horizon data.
IMPORTS_ENABLED=true
# The official Polymarket Gamma API. Only change this to point at a local stub in tests.
POLYMARKET_API_ORIGIN=https://gamma-api.polymarket.com
# Upper bound on how many child markets one event may contain. Each one is charged and created
# separately, so this also bounds what a single creation request can cost.
IMPORT_MAX_CHILDREN=24
