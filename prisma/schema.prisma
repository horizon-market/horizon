generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Service metadata only. Markets and collateral will remain authoritative on-chain.
model CreationRequest {
  id              String       @id @default(uuid()) @db.Uuid
  idempotencyKey  String       @unique
  question        String
  requesterKind   String
  status          String       @default("DRAFT")
  // Requester identity and a hashed per-request bearer token. The plaintext token is
  // returned exactly once and never stored, so admin database access cannot resume a request.
  requester       String       @default("")
  accessTokenHash String       @default("")
  // A request creates one standalone market (SINGLE) or the children of one event (GROUP).
  // Existing rows predate grouping and default to SINGLE, so their behaviour is unchanged.
  kind            String       @default("SINGLE")
  eventId         String?      @db.Uuid
  event           MarketEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // The exact draft a human reviewed. approvedHash must equal draftHash before payment.
  draft           Json?
  draftHash       String?
  draftProvider   String?
  draftMode       String?
  duplicates      Json?
  approvedAt      DateTime?
  approvedHash    String?
  // Discount and price are decided server-side when payment requirements are issued.
  discountBps     Int          @default(0)
  discountNote    String       @default("")
  priceUnits      String       @default("0")
  marketAddress   String?
  creationTxHash  String?
  // keccak256("horizon-creation:<id>") — the registry key the market is deployed under. Stored so
  // a MarketCreated event seen on the stream can find its request without reversing a hash.
  creationId      String?
  failureCode     String?
  failureDetail   String?
  attempts        Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  payment      PaymentIntent?
  notifications Notification[]
  verification HumanVerification?
  children     CreationChild[]
  auditEvents  AuditEvent[]

  @@index([status, createdAt])
  // A requester reads back their own creation history; the portfolio lists it newest first.
  @@index([requester, createdAt])
  @@index([eventId])
  @@index([creationId])
}

// ---------------------------------------------------------------------------
// Events and their children. This is service metadata, exactly like the draft
// above it: an event is a durable Horizon-owned grouping and a record of where
// its definitions came from. It is never a projection of chain state, and an
// imported market only becomes a real market once a child of it is deployed and
// The Graph indexes it. Every child stays an independent binary market with its
// own contracts, collateral, trading and resolution.
// ---------------------------------------------------------------------------
model MarketEvent {
  id               String    @id @default(uuid()) @db.Uuid
  // Stable, human-readable address for /events/:slug. Independent of any source slug.
  slug             String    @unique
  title            String
  description      String    @default("")
  category         String    @default("")
  // string[]; imported from the source's tags or entered manually.
  tags             Json?
  imageUrl         String?
  iconUrl          String?
  // COLLECTION: membership implies nothing about the children's outcomes.
  // EXCLUSIVE: the source or author states that exactly one child resolves YES.
  // Enforcement of EXCLUSIVE is in the resolution workflow only; see MarketEvent notes
  // in docs/ARCHITECTURE.md. Nothing about it is enforced by the market contracts.
  exclusivity      String    @default("COLLECTION")
  exclusivityNote  String    @default("")
  // Whether the imported children cover every outcome the source offered. A partial
  // selection is never presented as an exhaustive outcome set.
  outcomesComplete Boolean   @default(false)
  // Provenance. `horizon` for a manually authored event; `polymarket` for an import.
  sourceProvider   String    @default("horizon")
  sourceEventId    String?
  sourceSlug       String?
  sourceUrl        String?
  importedAt       DateTime?
  // The definitional metadata exactly as the source returned it. Source prices,
  // liquidity, volume and order-book fields are deliberately excluded: they are not
  // Horizon data and must never reach a Horizon surface.
  sourceSnapshot   Json?
  // DRAFT while its creation request is still in flight; ACTIVE once a child is deployed.
  status           String    @default("DRAFT")
  createdBy        String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members  EventMarket[]
  requests CreationRequest[]

  // One Horizon event per source event, which is what makes an import idempotent
  // under concurrent requests and retries.
  @@unique([sourceProvider, sourceEventId])
  @@index([status, createdAt])
}

// One child of an event: its outcome label, its order, and the market it became.
model EventMarket {
  id             String      @id @default(uuid()) @db.Uuid
  eventId        String      @db.Uuid
  event          MarketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position       Int
  outcomeLabel   String
  question       String
  // Set once this child is deployed. Unique across every event, so a market belongs to
  // at most one event and browsing can never render it as two cards.
  marketAddress  String?     @unique
  sourceMarketId String?
  sourceSlug     String?
  sourceUrl      String?
  sourceSnapshot Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([eventId, position])
  @@unique([eventId, sourceMarketId])
  @@index([marketAddress])
}

// Per-child deployment state inside one creation request. A retry redeploys only the
// children that are not already CREATED, so a partial failure never recreates a market
// and never charges again: the payment intent above is settled once, for the request.
model CreationChild {
  id             String          @id @default(uuid()) @db.Uuid
  requestId      String          @db.Uuid
  request        CreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  position       Int
  outcomeLabel   String
  // The exact reviewed MarketDraft for this child; the request's approval hash covers it.
  draft          Json
  draftHash      String
  // PENDING | SKIPPED | CREATING | CREATED | FAILED. SKIPPED children were deselected
  // before approval and are neither priced nor deployed.
  status         String          @default("PENDING")
  marketAddress  String?
  creationTxHash String?
  // keccak256("horizon-creation:<requestId>:<position>"); see CreationRequest.creationId.
  creationId     String?
  failureCode    String?
  failureDetail  String?
  attempts       Int             @default(0)
  // Warnings the importer raised for this child, preserved with the reviewed draft.
  notes          Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([requestId, position])
  @@index([status])
  @@index([creationId])
}

// Exactly one payment intent per creation request; retries reuse it and never re-settle.
model PaymentIntent {
  id             String          @id @default(uuid()) @db.Uuid
  requestId      String          @unique @db.Uuid
  request        CreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status         String          @default("REQUIRED")
  scheme         String          @default("exact")
  network        String
  asset          String
  amountUnits    String
  payTo          String
  nonce          String          @unique
  facilitator    String
  payloadHash    String?         @unique
  transactionRef String?         @unique
  payer          String?
  verifiedAt     DateTime?
  settledAt      DateTime?
  failureCode    String?
  attempts       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
}

// Minimum retained verification result: no image, document or raw proof is stored.
model HumanVerification {
  id             String          @id @default(uuid()) @db.Uuid
  requestId      String          @unique @db.Uuid
  request        CreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  nullifierHash  String
  credentialType String
  verifier       String
  verifiedAt     DateTime        @default(now())

  @@index([nullifierHash])
}

// One discounted creation per verified credential per UTC day.
model DiscountUsage {
  id            String   @id @default(uuid()) @db.Uuid
  nullifierHash String
  day           String
  requestId     String   @db.Uuid
  createdAt     DateTime @default(now())

  @@unique([nullifierHash, day])
}

// Admin resolution intent; the disclosed resolver key submits it from the worker.
model MarketResolution {
  id          String   @id @default(uuid()) @db.Uuid
  market      String   @unique
  result      String
  // Set when the market is a child of an explicitly exclusive event. Recorded so a
  // pending sibling resolution is visible to the next consistency check.
  eventId     String?  @db.Uuid
  evidence    String
  status      String   @default("PENDING")
  txHash      String?
  failureCode String?
  attempts    Int      @default(0)
  requestedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId, result])
}

// Append-only record of deliberate administrative actions.
model AdminAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actor     String
  action    String
  subject   String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A durable job side effect keyed by a stable business identifier.
model JobRun {
  id          String   @id @db.Uuid
  queueJobId  String   @db.Uuid
  label       String
  completedAt DateTime @default(now())
}

// Schema-owned session storage; excluded from Prisma Client and the admin UI.
model AdminSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "AdminSession_expire_idx")
  @@ignore
}

// ---------------------------------------------------------------------------
// Public audit trail (Hedera Consensus Service).
//
// A durable outbox. Every row is written in the same database transaction as the
// workflow transition it records, so a request can never advance without its
// statement being queued, and an unreachable topic can never repeat a payment,
// repeat a deployment or fail a user's creation. Publication is a background job.
//
// What HCS provides is a public, ordered, timestamped record of *Horizon's own
// statements* and the order in which it made them. It does not verify the Hedera
// payment, the Sepolia deployment or a market's outcome; each of those stays
// verifiable at its own source, and the references below are what link them.
// ---------------------------------------------------------------------------
model AuditEvent {
  id            String          @id @default(uuid()) @db.Uuid
  requestId     String          @db.Uuid
  request       CreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // sha256 over the schema id, the request id, the event type and — for a child of an event —
  // its position. Derived, stable, and the key readers deduplicate on: HCS orders and timestamps
  // messages, it does not deduplicate them, so a reconciled resubmission can appear twice.
  eventId       String          @unique
  type          String
  schemaVersion String
  // Publication order within one request. Fixed by type and position rather than counted, so the
  // outbox write is idempotent and two attempts can never claim different places in the order.
  sequence      Int
  // The exact statement, as public fields only. Re-encoded canonically before every submission,
  // so the bytes on the topic are a function of this row and not of jsonb key ordering.
  payload       Json
  // When the recorded fact happened, as this service observed it. Never the consensus timestamp.
  occurredAt    DateTime
  // True when the row was written after the fact rather than by the transition itself. Its
  // consensus timestamp is then the time of publication and says nothing about the event time.
  backfilled    Boolean         @default(false)
  // PENDING | PUBLISHING | UNCONFIRMED | PUBLISHED | FAILED. UNCONFIRMED is deliberate: the
  // submission's outcome is unknown, and it is reconciled against the mirror node before any
  // resubmission. Nothing is reported as published without a consensus timestamp.
  status        String          @default("PENDING")
  network       String?
  topicId       String?
  // Hedera transaction id, consensus timestamp and topic sequence number of the confirmed
  // message. All three stay null until the mirror-verifiable record exists.
  transactionId String?
  consensusAt   DateTime?
  // The topic's own sequence number, a decimal string like every other unbounded integer here.
  sequenceNumber String?
  attempts      Int             @default(0)
  nextAttemptAt DateTime?
  failureCode   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([requestId, sequence])
  @@index([status, nextAttemptAt])
  @@index([requestId, sequence])
}

// ---------------------------------------------------------------------------
// Read model. The registry and market contracts stay authoritative; every row
// below is a projection of Graph-indexed state, rebuilt by the sync worker and
// never written by a user request. Reads fall back to The Graph when the
// projection is stale, so a stopped worker degrades latency, never correctness.
// ---------------------------------------------------------------------------

model MarketProjection {
  address            String   @id
  creationId         String
  question           String
  rules              String
  evidenceSource     String
  closeAt            DateTime
  resolver           String
  yesToken           String
  noToken            String
  result             Int      @default(0)
  resolutionEvidence String
  // uint256 values are decimal strings, as elsewhere in this schema.
  collateral         String   @default("0")
  createdAt          DateTime
  indexedBlock       Int
  syncedAt           DateTime @default(now())

  curves CurveProjection[]

  @@index([createdAt])
  @@index([result, closeAt])
}

model CurveProjection {
  id            String           @id
  marketAddress String
  market        MarketProjection @relation(fields: [marketAddress], references: [address], onDelete: Cascade)
  maker         String
  flags         Int
  startPrice    Int
  endPrice      Int
  maxShares     String
  filled        String
  salt          String
  // Shipped to Aqua and not docked.
  active        Boolean
  // Admitted by the Horizon router, which checked its market budget. Only an admitted order fills.
  admitted      Boolean          @default(false)
  publishedAt   DateTime
  indexedBlock  Int
  syncedAt      DateTime         @default(now())

  @@index([maker, publishedAt])
  @@index([marketAddress, active, admitted])
}

// One row per projection, recording the Graph block the mirror is complete
// through. Freshness is judged from this, not from the age of individual rows.
model SyncCheckpoint {
  id           String   @id
  indexedBlock Int      @default(0)
  indexedHash  String   @default("")
  status       String   @default("OK")
  failureCode  String?
  markets      Int      @default(0)
  curves       Int      @default(0)
  durationMs   Int      @default(0)
  syncedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Live layer. The mirror above is owned by the periodic sync, which deletes any
// row the Graph sweep did not return — so nothing below is ever written into it.
// The stream consumer records what it sees on chain here, block by block, and
// reads apply these changes on top of whichever snapshot they are served from.
// Once a sweep reaches a change's block the snapshot covers it and the change
// is retired; a reorg deletes what the chain reverted. Every write for one block
// lands in one transaction with the stream cursor, so a crash can only replay a
// block, never half-record one.
// ---------------------------------------------------------------------------

// Where the Substreams consumer resumes from. One row, keyed by the module it consumes.
model StreamCheckpoint {
  id          String   @id
  cursor      String   @default("")
  blockNumber Int      @default(0)
  blockHash   String   @default("")
  // The server's final-block height as of the last message; a change at or below it is final.
  finalBlock  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// One observed change to one indexed entity, applied over a snapshot older than its block.
model LiveChange {
  id           BigInt    @id @default(autoincrement())
  // 'market' | 'curve'. Trades have their own table below; they never patch a snapshot.
  entity       String
  // The market address or the order hash the change belongs to, lower-cased.
  key          String
  // The chain event that produced it, e.g. MARKET_CREATED, CURVE_FILLED.
  kind         String
  // Lower-cased so a market page and a maker's curves can select their changes by index.
  market       String
  maker        String?
  payload      Json
  blockNumber  Int
  blockHash    String
  txHash       String
  logIndex     Int
  final        Boolean   @default(false)
  // Set once a sync sweep reached this block: the snapshot now carries the change itself.
  retiredAt    DateTime?
  createdAt    DateTime  @default(now())

  // A redelivered block upserts every change it carries and creates nothing new.
  @@unique([txHash, logIndex, entity, key])
  @@index([entity, key, blockNumber])
  @@index([market, blockNumber])
  @@index([maker, blockNumber])
  @@index([blockNumber])
  @@index([retiredAt])
}

// One taker route, from RouteExecuted. The fills inside it are not trades and not volume.
model Trade {
  // "<txHash>:<logIndex>", the same identity the Subgraph gives a Route.
  id          String    @id
  market      String
  taker       String
  recipient   String
  isYes       Boolean
  isBuy       Boolean
  shares      String
  usdc        String
  fills       Int
  blockNumber Int
  blockHash   String
  txHash      String
  final       Boolean   @default(false)
  // Kept after a reorg rather than deleted, and excluded from every history read.
  revertedAt  DateTime?
  source      String    @default("stream")
  createdAt   DateTime  @default(now())

  @@index([market, blockNumber])
  @@index([blockNumber])
}

// A creator-facing notice. Written by whichever of the receipt path and the stream sees the
// market first and merged by the other, so there is exactly one per created market.
model Notification {
  id            String          @id @default(uuid()) @db.Uuid
  // "<requestId>:<position or ->:<marketAddress>".
  dedupeKey     String          @unique
  requestId     String          @db.Uuid
  request       CreationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  position      Int?
  // Empty for an event notice, which names the whole group rather than one market.
  marketAddress String
  // 'market.created' for a standalone market; 'event.created', once, for a group.
  kind          String
  title         String
  body          String          @default("")
  href          String
  blockNumber   Int?
  txHash        String?
  // 'receipt' and/or 'stream'. A reorg removes a notice the stream alone vouched for.
  sources       String[]        @default([])
  readAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([requestId, createdAt])
  @@index([marketAddress])
}

// The SSE replay log. A browser that reconnects with the last id it saw is sent what it missed.
model LiveEvent {
  id          BigInt   @id @default(autoincrement())
  type        String
  // 'public', or 'creation:<requestId>' for a notice only that request's holder may receive.
  topic       String
  payload     Json
  blockNumber Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
