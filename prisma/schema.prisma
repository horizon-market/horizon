generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Service metadata only. Markets and collateral will remain authoritative on-chain.
model CreationRequest {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique
  question       String
  requesterKind String
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A diagnostic queue side effect; this is not a payment or market creation handler.
model JobRun {
  id          String   @id @db.Uuid
  queueJobId  String   @db.Uuid
  label       String
  completedAt DateTime @default(now())
}

// Schema-owned session storage; excluded from Prisma Client and the admin UI.
model AdminSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "AdminSession_expire_idx")
  @@ignore
}
