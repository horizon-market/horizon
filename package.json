{
  "name": "horizon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:test:migrate": "node --env-file=.env --import tsx scripts/migrate-test.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "admin:password": "tsx scripts/admin-password.ts",
    "job:probe": "tsx --env-file=.env scripts/enqueue-probe.ts",
    "resolve:invalid": "node --env-file=.env --import tsx scripts/resolve-invalid.ts",
    "doctor": "tsx --env-file=.env scripts/doctor.ts",
    "audit:topic": "node --env-file=.env --import tsx scripts/audit-topic.ts",
    "audit:verify": "node --env-file=.env --import tsx scripts/audit-verify.ts",
    "audit:backfill": "node --env-file=.env --import tsx scripts/audit-backfill.ts",
    "test": "node --import tsx --test test/unit.test.ts test/trading.test.ts test/budget.test.ts test/liquidity.test.ts test/creation.test.ts test/projection.test.ts test/imports.test.ts test/audit.test.ts",
    "test:routes": "node --import tsx --test --test-concurrency=1 test/routes.integration.test.ts test/budget.integration.test.ts",
    "subgraph:prepare": "node --env-file-if-exists=.env --import tsx scripts/subgraph-prepare.ts",
    "subgraph:codegen": "graph codegen subgraph/subgraph.yaml --output-dir subgraph/generated",
    "subgraph:build": "graph build subgraph/subgraph.yaml --output-dir subgraph/build",
    "deploy:phase2": "node --env-file=.env --import tsx scripts/deploy-phase2.ts --broadcast",
    "subgraph:deploy": "node --env-file=.env --import tsx scripts/subgraph-deploy.ts",
    "demo:seed": "node --env-file=.env --import tsx scripts/seed-phase2.ts",
    "demo:live": "node --env-file=.env --import tsx scripts/verify-phase2-live.ts",
    "demo:indexed": "node --env-file=.env --import tsx scripts/verify-phase2-indexed.ts",
    "agent:create": "node --env-file=.env --import tsx scripts/agent-create.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/integration.test.ts test/creation.integration.test.ts test/projection.integration.test.ts test/events.integration.test.ts test/audit.integration.test.ts",
    "vendor:verify": "node --import tsx scripts/verify-vendor.ts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "contracts:demo": "forge test --root contracts --match-test testSixtyFortyBackedMatchAndWinnerRedemption -vvvv",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "@adminjs/express": "6.1.1",
    "@adminjs/prisma": "5.0.4",
    "@anthropic-ai/sdk": "0.124.0",
    "@hiero-ledger/sdk": "2.85.0",
    "@prisma/client": "6.19.3",
    "@worldcoin/idkit-core": "4.2.3",
    "@x402/core": "2.25.0",
    "@x402/hedera": "2.25.0",
    "adminjs": "7.8.17",
    "connect-pg-simple": "10.0.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-formidable": "1.2.0",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "pg": "8.23.0",
    "pg-boss": "10.4.2",
    "tslib": "2.8.1",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
