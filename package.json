{
  "name": "horizon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "worker": "node --env-file=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:test:migrate": "node --env-file=.env --import tsx scripts/migrate-test.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "admin:password": "tsx scripts/admin-password.ts",
    "job:probe": "tsx --env-file=.env scripts/enqueue-probe.ts",
    "doctor": "tsx --env-file=.env scripts/doctor.ts",
    "test": "node --import tsx --test test/unit.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/integration.test.ts",
    "vendor:verify": "node --import tsx scripts/verify-vendor.ts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "contracts:demo": "forge test --root contracts --match-test testSixtyFortyBackedMatchAndWinnerRedemption -vvvv"
  },
  "dependencies": {
    "@adminjs/express": "6.1.1",
    "@adminjs/prisma": "5.0.4",
    "@prisma/client": "6.19.3",
    "adminjs": "7.8.17",
    "connect-pg-simple": "10.0.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-formidable": "1.2.0",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "pg": "8.23.0",
    "pg-boss": "10.4.2",
    "tslib": "2.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
